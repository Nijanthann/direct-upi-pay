# Database connection
# For quick local testing / development (SQLite):
DATABASE_URL="file:./dev.db"

# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upi_pay?schema=public"

# JWT Secret for Session Cookies (generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-secret-key-replace-in-production"

# Application public URL
APP_URL="http://localhost:3000"

# Dynamic QR code expiration window in minutes
QR_EXPIRATION_MINUTES=5

# Environment mode
NODE_ENV="development"
